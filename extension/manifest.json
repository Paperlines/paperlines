{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Paperlines",
  "description": "__MSG_description__",
  "version": "0.1.4",
  "default_locale": "en",
  "homepage_url": "https://github.com/Paperlines/paperlines",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "key": ""
}
